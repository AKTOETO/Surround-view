inline constexpr std::string_view projection_vertex = R"SVGLSL(@SV_PROJECTION_VERT@)SVGLSL";
inline constexpr std::string_view projection_fragment = R"SVGLSL(@SV_PROJECTION_FRAG@)SVGLSL";
inline constexpr std::string_view vehicle_vertex = R"SVGLSL(@SV_VEHICLE_VERT@)SVGLSL";
