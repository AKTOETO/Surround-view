include_guard(GLOBAL)

# Inspect ELF metadata only: never run a target library or host ldd during cross builds.
function(sv_install_bundled_opencv)
  if(NOT SV_BUNDLE_OPENCV)
    return()
  endif()
  if(CMAKE_READELF)
    set(_readelf "${CMAKE_READELF}")
  else()
    find_program(_readelf NAMES readelf REQUIRED)
  endif()
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
    set(_machine "AArch64")
    set(_class ELF64)
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(arm|armv[5-8].*)$")
    set(_machine "ARM")
    set(_class ELF32)
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|amd64|AMD64)$")
    set(_machine "Advanced Micro Devices X86-64")
    set(_class ELF64)
  elseif(CMAKE_SYSTEM_PROCESSOR MATCHES "^(i[3-6]86|x86)$")
    set(_machine "Intel 80386")
    set(_class ELF32)
  else()
    message(FATAL_ERROR "Unsupported OpenCV bundle target processor: ${CMAKE_SYSTEM_PROCESSOR}")
  endif()

  file(REAL_PATH "${SV_OPENCV_BUNDLE_ROOT}" _root)
  file(GLOB_RECURSE _licenses "${_root}/licenses/*")
  if(NOT _licenses)
    message(FATAL_ERROR "OpenCV bundle must include upstream and third-party notices in licenses/")
  endif()
  file(GLOB _libraries "${_root}/lib/libopencv_*.so*" "${_root}/lib64/libopencv_*.so*")
  if(NOT _libraries)
    message(FATAL_ERROR "OpenCV bundle contains no shared libraries in lib or lib64")
  endif()
  set(_names)
  set(_real_libraries)
  foreach(_library IN LISTS _libraries)
    get_filename_component(_name "${_library}" NAME)
    if(_name IN_LIST _names)
      message(FATAL_ERROR "Duplicate OpenCV bundle library name: ${_name}")
    endif()
    list(APPEND _names "${_name}")
    if(IS_SYMLINK "${_library}")
      file(READ_SYMLINK "${_library}" _link)
      if(IS_ABSOLUTE "${_link}")
        message(FATAL_ERROR "OpenCV bundle symlinks must be relative: ${_library}")
      endif()
    endif()
    file(REAL_PATH "${_library}" _real)
    file(RELATIVE_PATH _relative "${_root}" "${_real}")
    if(_relative MATCHES "^\\.\\./" OR IS_ABSOLUTE "${_relative}" OR NOT EXISTS "${_real}")
      message(FATAL_ERROR "OpenCV bundle library escapes root or is missing: ${_library}")
    endif()
    list(APPEND _real_libraries "${_real}")
  endforeach()
  list(REMOVE_DUPLICATES _real_libraries)
  foreach(_include IN LISTS SV_OPENCV_INCLUDE_DIRS)
    file(REAL_PATH "${_include}" _real)
    file(RELATIVE_PATH _relative "${_root}" "${_real}")
    if(NOT IS_DIRECTORY "${_real}" OR _relative MATCHES "^\\.\\./" OR IS_ABSOLUTE "${_relative}")
      message(FATAL_ERROR "OpenCV include directory escapes bundle or is missing: ${_include}")
    endif()
  endforeach()
  foreach(_target IN LISTS SV_OPENCV_LIBRARIES)
    if(NOT TARGET ${_target})
      message(FATAL_ERROR "Bundled OpenCV must expose imported library targets: ${_target}")
    endif()
    get_target_property(_configurations ${_target} IMPORTED_CONFIGURATIONS)
    set(_locations)
    get_target_property(_location ${_target} IMPORTED_LOCATION)
    if(_location)
      list(APPEND _locations "${_location}")
    endif()
    foreach(_configuration IN LISTS _configurations)
      get_target_property(_location ${_target} IMPORTED_LOCATION_${_configuration})
      if(_location)
        list(APPEND _locations "${_location}")
      endif()
    endforeach()
    if(NOT _locations)
      message(FATAL_ERROR "Bundled OpenCV target has no shared library location: ${_target}")
    endif()
    foreach(_location IN LISTS _locations)
      file(REAL_PATH "${_location}" _real)
      if(NOT _real IN_LIST _real_libraries)
        message(FATAL_ERROR "OpenCV imported target escapes validated bundle libraries: ${_target}: ${_location}")
      endif()
    endforeach()
  endforeach()
  foreach(_library IN LISTS _real_libraries)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E env LC_ALL=C "${_readelf}" -h -d "${_library}"
      RESULT_VARIABLE _status OUTPUT_VARIABLE _elf ERROR_VARIABLE _error)
    if(NOT _status EQUAL 0 OR NOT _elf MATCHES "Type:[ \t]+DYN" OR
        NOT _elf MATCHES "Machine:[ \t]+${_machine}[\r\n]" OR
        NOT _elf MATCHES "Class:[ \t]+${_class}[\r\n]" OR
        NOT _elf MATCHES "Data:[ \t]+2's complement, little endian")
      message(FATAL_ERROR "OpenCV bundle ELF architecture/type mismatch: ${_library}: ${_error}")
    endif()
    if(NOT _elf MATCHES "\\(SONAME\\)[^\n]*\\[([^]]+)\\]")
      message(FATAL_ERROR "OpenCV bundle library lacks SONAME: ${_library}")
    endif()
    set(_soname "${CMAKE_MATCH_1}")
    if(NOT _soname IN_LIST _names)
      message(FATAL_ERROR "OpenCV bundle missing SONAME link: ${_soname}")
    endif()
    string(REGEX MATCHALL "\\((RUNPATH|RPATH)\\)[^\n]*\\[[^]]+\\]" _paths "${_elf}")
    if(NOT _paths)
      message(FATAL_ERROR "OpenCV bundle needs a private $ORIGIN RUNPATH: ${_library}")
    endif()
    foreach(_path IN LISTS _paths)
      string(REGEX MATCH "\\[([^]]+)\\]" _unused "${_path}")
      if(NOT CMAKE_MATCH_1 STREQUAL "$ORIGIN")
        message(FATAL_ERROR "OpenCV bundle RUNPATH must be exactly $ORIGIN: ${_library}")
      endif()
    endforeach()
    string(REGEX MATCHALL "\\(NEEDED\\)[^\n]*\\[[^]]+\\]" _needed "${_elf}")
    foreach(_entry IN LISTS _needed)
      string(REGEX MATCH "\\[([^]]+)\\]" _unused "${_entry}")
      set(_dependency "${CMAKE_MATCH_1}")
      if(_dependency MATCHES "^libopencv_" AND NOT _dependency IN_LIST _names)
        message(FATAL_ERROR "OpenCV bundle missing private dependency: ${_dependency}")
      endif()
    endforeach()
  endforeach()
  # Preserve validated relative SONAME/development links. Headers/config are build inputs only.
  install(FILES ${_libraries} DESTINATION "${CMAKE_INSTALL_LIBDIR}/surround-view/opencv")
  install(DIRECTORY "${_root}/licenses/"
    DESTINATION "${CMAKE_INSTALL_DATADIR}/licenses/surround-view/opencv-bundle")
endfunction()

function(sv_opencv_private_rpath target)
  if(SV_OPENCV_FETCHED OR SV_BUNDLE_OPENCV)
    set_property(TARGET ${target} APPEND PROPERTY INSTALL_RPATH
      "$ORIGIN/../${CMAKE_INSTALL_LIBDIR}/surround-view/opencv")
    set_property(TARGET ${target} PROPERTY INSTALL_RPATH_USE_LINK_PATH FALSE)
  endif()
endfunction()
