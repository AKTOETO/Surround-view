include_guard(GLOBAL)

# Quote data for JSON; do not substitute it as C++ source or generator expressions.
function(sv_passport_quote out value)
  string(LENGTH "${value}" value_bytes)
  if(value_bytes GREATER 8192)
    message(FATAL_ERROR "Configured build passport string exceeds8KiB")
  endif()
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(sv_configure_build_passport)
  if(NOT DEFINED SV_SDK_ID)
    set(SV_SDK_ID "unreported" CACHE STRING "Declared SDK identity for provenance (not attestation)")
  endif()
  set(configs ${CMAKE_CONFIGURATION_TYPES})
  if(NOT configs)
    set(configs "${CMAKE_BUILD_TYPE}")
  endif()
  # foreach over an empty single-config build still needs one entry.
  if(NOT configs)
    set(configs "__sv_unspecified__")
  endif()
  foreach(config IN LISTS configs)
    if(config STREQUAL "__sv_unspecified__")
      set(config "")
    endif()
    string(TOUPPER "${config}" upper)
    set(name "${config}")
    if(name STREQUAL "")
      set(name "unspecified")
    endif()
    set(json "{\"schema_version\":1,\"scope\":\"configured_build_v1\"}")
    foreach(group source toolchain target configuration dependencies features)
      string(JSON json SET "${json}" ${group} "{}")
    endforeach()
    set(entries
      source/version/PROJECT_VERSION source/revision/SV_SOURCE_REVISION
      source/fingerprint/SV_SOURCE_FINGERPRINT
      toolchain/compiler_id/CMAKE_CXX_COMPILER_ID toolchain/compiler_version/CMAKE_CXX_COMPILER_VERSION
      toolchain/compiler_target/CMAKE_CXX_COMPILER_TARGET
      target/system/CMAKE_SYSTEM_NAME target/system_version/CMAKE_SYSTEM_VERSION
      target/processor/CMAKE_SYSTEM_PROCESSOR target/sysroot/CMAKE_SYSROOT target/sdk_id/SV_SDK_ID
      configuration/generator/CMAKE_GENERATOR
      dependencies/opencv_configured_version/SV_OPENCV_CONFIGURED_VERSION
      dependencies/opencv_provision/SV_OPENCV_PROVISION dependencies/glm_provision/SV_GLM_PROVISION
      dependencies/egl_configured_version/EGL_VERSION dependencies/gles_configured_version/GLES_VERSION)
    foreach(entry IN LISTS entries)
      string(REPLACE "/" ";" parts "${entry}")
      list(GET parts 0 group)
      list(GET parts 1 key)
      list(GET parts 2 variable)
      sv_passport_quote(quoted "${${variable}}")
      string(JSON json SET "${json}" ${group} ${key} "${quoted}")
    endforeach()
    sv_passport_quote(quoted "${name}")
    string(JSON json SET "${json}" configuration name "${quoted}")
    sv_passport_quote(quoted "${CMAKE_CXX_FLAGS} ${CMAKE_CXX_FLAGS_${upper}}")
    string(JSON json SET "${json}" configuration cxx_flags "${quoted}")
    sv_passport_quote(quoted "${CMAKE_EXE_LINKER_FLAGS} ${CMAKE_EXE_LINKER_FLAGS_${upper}}")
    string(JSON json SET "${json}" configuration executable_link_flags "${quoted}")
    if(DEFINED CMAKE_INTERPROCEDURAL_OPTIMIZATION_${upper})
      set(ipo "${CMAKE_INTERPROCEDURAL_OPTIMIZATION_${upper}}")
    else()
      set(ipo "${CMAKE_INTERPROCEDURAL_OPTIMIZATION}")
    endif()
    sv_passport_quote(quoted "${ipo}")
    string(JSON json SET "${json}" configuration interprocedural_optimization "${quoted}")
    sv_passport_quote(quoted "${CMAKE_POSITION_INDEPENDENT_CODE}")
    string(JSON json SET "${json}" configuration position_independent_code "${quoted}")
    foreach(kind COMPILE LINK)
      get_directory_property(options ${kind}_OPTIONS)
      set(array "[]")
      set(index 0)
      foreach(option IN LISTS options)
        sv_passport_quote(quoted "${option}")
        string(JSON array SET "${array}" ${index} "${quoted}")
        math(EXPR index "${index}+1")
      endforeach()
      string(TOLOWER "${kind}" lower)
      string(JSON json SET "${json}" configuration project_${lower}_options "${array}")
    endforeach()
    string(JSON json SET "${json}" toolchain cxx_standard ${CMAKE_CXX_STANDARD})
    string(JSON json SET "${json}" toolchain toolchain_sha256 null)
    if(CMAKE_TOOLCHAIN_FILE)
      get_filename_component(toolchain "${CMAKE_TOOLCHAIN_FILE}" ABSOLUTE BASE_DIR "${CMAKE_BINARY_DIR}")
      if(NOT EXISTS "${toolchain}")
        get_filename_component(toolchain "${CMAKE_TOOLCHAIN_FILE}" ABSOLUTE BASE_DIR "${CMAKE_SOURCE_DIR}")
      endif()
      if(NOT EXISTS "${toolchain}")
        message(FATAL_ERROR "Cannot hash CMAKE_TOOLCHAIN_FILE for build passport")
      endif()
      set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${toolchain}")
      file(SHA256 "${toolchain}" toolchain_hash)
      string(JSON json SET "${json}" toolchain toolchain_sha256 "\"${toolchain_hash}\"")
    endif()
    foreach(flag SV_GPU SV_SANITIZERS SV_AURORA SV_BUNDLE_OPENCV SV_OPENCV_FETCHED CMAKE_CROSSCOMPILING)
      if(${flag})
        set(value true)
      else()
        set(value false)
      endif()
      string(JSON json SET "${json}" features ${flag} ${value})
    endforeach()
    string(LENGTH "${json}" bytes)
    if(bytes GREATER 12288)
      message(FATAL_ERROR "Configured build passport exceeds12KiB")
    endif()
    # A collision-free C++ raw delimiter preserves arbitrary flag quotes/backslashes/newlines.
    set(index 0)
    while(TRUE)
      set(delimiter "SV_BUILD_${index}")
      string(FIND "${json}" ")${delimiter}\"" found)
      if(found EQUAL -1)
        break()
      endif()
      math(EXPR index "${index}+1")
    endwhile()
    file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/generated/${config}/sv")
    set(content "#pragma once\nnamespace sv::build_detail {\ninline constexpr const char* configured_json = R\"${delimiter}(${json})${delimiter}\";\n}\n")
    # configure_file COPYONLY avoids rewriting unchanged headers and does not evaluate $<...> data.
    file(WRITE "${CMAKE_BINARY_DIR}/CMakeFiles/build-passport-${name}.hpp" "${content}")
    configure_file("${CMAKE_BINARY_DIR}/CMakeFiles/build-passport-${name}.hpp"
      "${CMAKE_BINARY_DIR}/generated/${config}/sv/build_configuration.hpp" COPYONLY)
  endforeach()
  target_include_directories(sv-core BEFORE PRIVATE "${CMAKE_BINARY_DIR}/generated/$<CONFIG>")
endfunction()
